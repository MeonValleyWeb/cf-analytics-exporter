{
  // Values and resource IDs must never leave the parser boundary.
  "name": "example-worker",
  "account_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_MODE": "production",
    "JSON_CONFIG": { "enabled": true }
  },
  "secrets": {
    "required": ["API_KEY", "DATABASE_URL"]
  },
  "kv_namespaces": [{ "binding": "CACHE", "id": "private-id" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "private-bucket" }],
  "ai": { "binding": "AI" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.5,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "env": {
    "staging": {
      "vars": { "PUBLIC_MODE": "staging" },
      "secrets": { "required": ["STAGING_KEY"] },
      "d1_databases": [{ "binding": "DB", "database_id": "private-db" }]
    }
  }
}
