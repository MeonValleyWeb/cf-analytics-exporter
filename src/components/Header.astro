---
import AuthButtons from './AuthButtons';

const currentPath = Astro.url.pathname;
---

<header class="bg-white shadow-sm">
  <nav class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="flex min-h-16 flex-wrap items-center justify-between gap-3 py-3 lg:flex-nowrap">
      <a href="/" class="flex items-center gap-2 text-xl font-semibold text-orange-600">
        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
        </svg>
        CF Analytics
      </a>
      <div
        class="order-last flex w-full items-center gap-5 overflow-x-auto pb-1 lg:order-none lg:ml-auto lg:w-auto lg:overflow-visible lg:pb-0"
      >
        <a
          href="/"
          class:list={[
            'text-sm font-medium transition-colors',
            currentPath === '/' ? 'text-orange-600' : 'text-gray-600 hover:text-gray-900'
          ]}
        >
          Home
        </a>
        <a
          href="/dashboard"
          class:list={[
            'text-sm font-medium transition-colors',
            currentPath === '/dashboard' ? 'text-orange-600' : 'text-gray-600 hover:text-gray-900'
          ]}
        >
          Dashboard
        </a>
        <a
          href="/crawler-guard"
          class:list={[
            'text-sm font-medium transition-colors',
            currentPath === '/crawler-guard'
              ? 'text-orange-600'
              : 'text-gray-600 hover:text-gray-900'
          ]}
        >
          Crawler Guard
        </a>
        <a
          href="/config-guard"
          class:list={[
            'text-sm font-medium transition-colors',
            currentPath === '/config-guard'
              ? 'text-orange-600'
              : 'text-gray-600 hover:text-gray-900'
          ]}
        >
          Config Guard
        </a>
        <a
          href="/docs/config-guard"
          class:list={[
            'text-sm font-medium transition-colors',
            currentPath === '/docs/config-guard'
              ? 'text-orange-600'
              : 'text-gray-600 hover:text-gray-900'
          ]}
        >
          Guide
        </a>
        <a
          href="/settings"
          class:list={[
            'text-sm font-medium transition-colors',
            currentPath === '/settings' ? 'text-orange-600' : 'text-gray-600 hover:text-gray-900'
          ]}
        >
          Settings
        </a>
      </div>
      <div class="flex shrink-0 items-center">
        <AuthButtons client:only="react" />
      </div>
    </div>
  </nav>
</header>
